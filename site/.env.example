# Livraison des demandes du formulaire de contact.
#
# L'action serveur tente les trois canaux ci-dessous et considère la demande
# comme reçue dès qu'un seul aboutit. Si AUCUN n'est configuré ni disponible,
# le visiteur voit une erreur et l'adresse email directe — jamais un faux
# « message envoyé ».
#
# En local, l'écriture dans .data/requests.jsonl suffit à faire fonctionner le
# formulaire. En production sur Vercel ou Netlify, le système de fichiers est
# éphémère : configurez Resend ou un webhook, sinon les demandes sont perdues.

# --- Canal 1 : email via Resend (https://resend.com) ---
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO=
# Expéditeur, sur un domaine vérifié chez Resend
CONTACT_FROM=

# --- Canal 2 : webhook JSON (Slack, Make, n8n, Zapier…) ---
CONTACT_WEBHOOK_URL=
